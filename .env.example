# GEMINI_API_KEY: Required for Gemini AI news analysis, scripts, and headlines.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Production or dev deployment URL (e.g. https://as-automatic-video-submitter.netlify.app)
APP_URL="https://as-automatic-video-submitter.netlify.app"

# ==============================================================
# X / TWITTER OAUTH 2.0 PKCE CONFIGURATION
# Register in X Developer Portal (developer.x.com):
# Type: Web App or Single Page App
# Redirect URL: https://as-automatic-video-submitter.netlify.app/auth/callback
# ==============================================================
X_CLIENT_ID="YOUR_X_CLIENT_ID"
X_CLIENT_SECRET="YOUR_X_CLIENT_SECRET" # Optional if configured as Public Client (PKCE)
X_REDIRECT_URI="https://as-automatic-video-submitter.netlify.app/auth/callback"
X_SCOPES="tweet.read users.read follows.read offline.access"
X_BEARER_TOKEN="YOUR_X_BEARER_TOKEN" # Optional fallback for search

# ==============================================================
# META / FACEBOOK GRAPH API OAUTH CONFIGURATION
# Register in Meta Developer Portal (developers.facebook.com):
# App Type: Business or Consumer
# Valid OAuth Redirect URI: https://as-automatic-video-submitter.netlify.app/auth/facebook/callback
# Permissions: pages_manage_posts, pages_read_engagement, pages_show_list, publish_video
# ==============================================================
META_APP_ID="YOUR_META_FACEBOOK_APP_ID"
META_APP_SECRET="YOUR_META_FACEBOOK_APP_SECRET"
META_REDIRECT_URI="https://as-automatic-video-submitter.netlify.app/auth/facebook/callback"
META_GRAPH_API_VERSION="v21.0"

# OAUTH_SECRET: Secret key for signing stateless PKCE state tokens
OAUTH_SECRET="as-automation-secret-key-production-39148"
